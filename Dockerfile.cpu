# CPU build. Same application, no CUDA. Two reasons it exists:
#   1. CI can smoke-test the real service without a GPU runner.
#   2. It is the fallback when the GPU is busy -- a 16-core host scores a one-second
#      clip in a couple of seconds, which is slow for a 1457-clip sweep but fine for a
#      handful of spot checks.
FROM python:3.12-slim-bookworm

ARG TORCH_VERSION=2.7.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH="/srv" \
    HOME="/config" \
    HF_HOME="/config/huggingface" \
    TORCH_HOME="/config/torch" \
    XDG_CACHE_HOME="/config/cache" \
    NLTK_DATA="/usr/local/share/nltk_data" \
    WAVLM_DEVICE=cpu \
    PORT=8000

WORKDIR /srv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        gosu \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /srv/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        "torch==${TORCH_VERSION}" \
        "torchaudio==${TORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install -r /srv/requirements.txt

RUN python -m nltk.downloader -d "${NLTK_DATA}" \
        averaged_perceptron_tagger \
        averaged_perceptron_tagger_eng \
        cmudict

COPY app /srv/app
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /config/huggingface /config/torch /config/cache \
+    && chown -R 99:100 /config

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

ENV APP_VERSION=${VERSION}

LABEL org.opencontainers.image.title="WavLM Phoneme Validator (CPU)" \
      org.opencontainers.image.description="Phoneme-level pronunciation scoring API with explicit expected-pronunciation input" \
      org.opencontainers.image.source="https://github.com/KenGrinder/wavlm-phoneme-validator" \
      org.opencontainers.image.url="https://github.com/KenGrinder/wavlm-phoneme-validator" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"

USER 99:100

VOLUME ["/config"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=25m --retries=3 \
    CMD ["python", "-m", "app.healthcheck"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=${FORWARDED_ALLOW_IPS:-127.0.0.1}"]
